# Red.ly - variables de entorno (ejemplo)
# Copia este archivo a .env.local y ajusta los valores si hace falta.
# No coloques secretos: este proyecto no usa claves ni cuentas.

# Endpoints de la fuente primaria (misma familia de producto)
SAVETIK_BASE_URL=https://savetikpro.com
SAVETIK_AJAX_SEARCH_URL=https://savetikpro.com/api/ajaxSearch
SAVETIK_HOME_PATH=/en
SAVETIK_LANG=en

# Fallback para vídeos sueltos
TIKVID_BASE_URL=https://tikvid.io
TIKVID_AJAX_SEARCH_URL=https://tikvid.io/api/ajaxSearch

# Fuente de YouTube vía SnapYT (vídeos sueltos y Shorts)
SNAPYT_BASE_URL=https://www.snapyt.app
# Endpoint admin-ajax.php: nonce, process_video_url y descarga forzada.
SNAPYT_AJAX_URL=https://www.snapyt.app/wp-admin/admin-ajax.php

# Listas de reproducción de YouTube vía YTMP3.gg (API de metadatos).
YT_YTMP3_META_BASE_URL=https://yt-meta.convert1s.com
YT_YTMP3_PLAYLIST_PATH=/playlist
# Vídeos por página que el servicio devuelve de un tirón (máximo observable).
YT_YTMP3_MAX_PER_PAGE=100

# Fuente de Facebook vía FSave (vídeo suelto: mint → resolve → render).
# FSAVE_MINT_KEY es la clave HMAC pública del JS del servicio; si gira, la
# fuente la relee de FSAVE_SENSOR_URL y reintenta, así que no hace falta
# actualizarla a mano.
FSAVE_BASE_URL=https://fsave.net
FSAVE_MINT_URL=https://fsave.net/mint.php
FSAVE_PROXY_URL=https://fsave.net/proxy.php
FSAVE_SENSOR_URL=https://fsave.net/assets/js/sensor.js
FSAVE_MINT_KEY=d0776d5ce84657543697c00bab933acb
# Sondeos máximos de un trabajo de render antes de rendirse.
FSAVE_RENDER_ATTEMPTS=20

# Fuente de Instagram vía IGExport (publicación suelta: ig-reels → ig-photo).
IGEXPORT_BASE_URL=https://igexport.com
IGEXPORT_REELS_URL=https://igexport.com/api/ig-reels/
IGEXPORT_PHOTO_URL=https://igexport.com/api/ig-photo/
# oEmbed público de Instagram para el título/autor (best-effort; si falla, la
# fuente se conforma con el autor o el código de la publicación).
INSTAGRAM_OEMBED_URL=https://www.instagram.com/api/v1/oembed/

# Respaldo de Instagram vía LoveInsta (publicación suelta en un solo POST a
# proxy.php; los jobs de render se resuelven con FSAVE_RENDER_ATTEMPTS).
LOVEINSTA_BASE_URL=https://loveinsta.com
LOVEINSTA_PROXY_URL=https://loveinsta.com/proxy.php

# Fuente de X (Twitter) vía iLoveX (tweet suelto: resolve → render → fileUrl).
# Sin mint ni Turnstile: un solo POST a proxy.php y sondeo del job.
ILOVEX_BASE_URL=https://ilovex.com
ILOVEX_PROXY_URL=https://ilovex.com/proxy.php
# Sondeos máximos de un trabajo de render antes de rendirse.
ILOVEX_RENDER_ATTEMPTS=20

# Fuente de Threads vía SaveThreads (publicación suelta: resolve → render →
# fileUrl). Sin mint ni Turnstile: un solo POST a proxy.php y sondeo del job.
SAVETHREADS_BASE_URL=https://savethreads.com
SAVETHREADS_PROXY_URL=https://savethreads.com/proxy.php
# Sondeos máximos de un trabajo de render antes de rendirse.
SAVETHREADS_RENDER_ATTEMPTS=20

REQUEST_TIMEOUT=30
DOWNLOAD_TIMEOUT=120
MAX_REDIRECTS=5

RETRY_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=0.8

# Tope de vídeos POR INVOCACIÓN en /api/profile (no por perfil: el cliente
# pagina con `cursor` y cada llamada devuelve una página).
API_PROFILE_MAX=100

# Límite de tasa compartido por /api/search, /api/profile y /api/download.
# En serverless el límite es por instancia de la función, no global.
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# TTL de la caché de páginas de perfil. Debe ser bien inferior a la vida del
# token de descarga (~1 h): cada tarjeta trae una URL temporal.
PROFILE_CACHE_TTL_MS=60000
